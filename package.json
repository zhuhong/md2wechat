{
  "name": "md2wechat",
  "private": true,
  "version": "0.1.0",
  "description": "Markdown editor optimized for WeChat article publishing",
  "scripts": {
    "dev": "pnpm -r --parallel --filter @md2wechat/server --filter @md2wechat/web dev",
    "dev:web": "pnpm --filter @md2wechat/web dev",
    "dev:server": "pnpm --filter @md2wechat/server dev",
    "build": "pnpm -r build",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "@types/node": "^22.0.0"
  },
  "packageManager": "pnpm@9.15.0"
}
